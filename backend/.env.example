# Copy to backend/.env and supply your own credentials. Never commit .env.
# Canonical LLM_* names; OPENAI_API_KEY/OPENAI_BASE_URL/OPENAI_MODEL remain aliases.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=
LLM_TIMEOUT=60
AMAP_API_KEY=
TOOL_TIMEOUT=20
TOOL_TOTAL_TIMEOUT=50
TOOL_MAX_ATTEMPTS=2
TOOL_CONCURRENCY=3
# Optional retrieval cache. Empty disables Redis; use rediss:// for TLS.
REDIS_URL=
REDIS_TIMEOUT=0.3

# Optional durable plan storage. Production uses MySQL through PyMySQL.
DATABASE_URL=

# Bounded route-matrix execution.
ROUTE_MAX_POINTS=6
ROUTE_CONCURRENCY=3
ROUTE_LEG_TIMEOUT=60
ROUTE_MATRIX_TIMEOUT=90
# Optional image enhancement
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
