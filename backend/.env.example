# Copy to backend/.env and supply your own credentials. Never commit .env.
# Canonical LLM_* names; OPENAI_API_KEY/OPENAI_BASE_URL/OPENAI_MODEL remain aliases.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=
LLM_TIMEOUT=60
AMAP_API_KEY=
# Optional image enhancement
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
